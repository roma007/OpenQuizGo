# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
APP_ENV=dev
APP_VERSION=dev
HTTP_ADDR=:8080
LOG_LEVEL=info

# 本地开发：使用本机 PostgreSQL / Redis
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openquizgo?sslmode=disable
REDIS_URL=redis://localhost:6379/0

DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s

# 认证与加密（生产环境必须替换）
JWT_SECRET=dev-insecure-jwt-secret-change-me-please
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PHONE_HASH_KEY=dev-phone-hash-key-change-me

# 短信：mock 模式不发送，固定验证码；生产需接入真实通道
SMS_MODE=mock
SMS_MOCK_CODE=123456

# 集成测试（留空则跳过；建议使用独立测试库与 Redis DB）
TEST_DATABASE_URL=
TEST_REDIS_URL=
